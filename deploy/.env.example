# Deploy King settings for deploy/compose.yml. Copy to deploy/.env, or run: bash deploy/gen-env.sh
# Keep comments on their own lines. Use letters and digits only in passwords (they go into URLs).

# ── Secrets (required) ─────────────────────────────────────────────
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 24
REDIS_PASSWORD=
# openssl rand -hex 48
JWT_SECRET=
# openssl rand -hex 32
INTERNAL_SECRET=
# 64 hex characters: openssl rand -hex 32. Encrypts stored variables and tokens. Keep a copy.
MASTER_KEY=

# ── First admin ────────────────────────────────────────────────────
# Created when there is no user yet. Asked to change the password at the first sign-in.
# Empty: a password is made up and printed once in the API's log (docker logs dbbkp-api).
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# ── Addresses ──────────────────────────────────────────────────────
# Apps get <name>.<DBBKP_BASE_DOMAIN>. "localhost" works in a browser on the same machine.
DBBKP_BASE_DOMAIN=localhost
# The panel through the proxy (the panel also answers on PANEL_PORT directly).
PANEL_DOMAIN=portal.localhost
# true only together with compose.tls.yml (see COMPOSE_FILE below)
DBBKP_TLS=false
# Let's Encrypt account e-mail (HTTPS only)
ACME_EMAIL=
# Shown as the address for webhooks, e.g. https://portal.example.com
PUBLIC_API_URL=

# ── Ports on this machine ──────────────────────────────────────────
PANEL_BIND=0.0.0.0
PANEL_PORT=3000
# The API is published for local tools only
API_BIND=127.0.0.1
API_PORT=4000
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443

# ── Images ─────────────────────────────────────────────────────────
# Built from this checkout by default. For the published images:
#   DK_IMAGE_PREFIX=ghcr.io/iamprashanta/deploy-king and DK_TAG=latest (or a version), then
#   docker compose pull && docker compose up -d --no-build
DK_IMAGE_PREFIX=deploy-king
DK_TAG=local
# Source checkout to build from (relative to this folder)
DK_SOURCE=..

# ── Optional ───────────────────────────────────────────────────────
# HTTPS: COMPOSE_FILE=compose.yml:compose.tls.yml
# Where app sources are kept: a named volume, or a folder such as /var/www/sites
# DK_SITES_DIR=dk-sites
# Server watch (scripts/install-scan.sh): folders on the host
# DK_SCAN_DIR=/opt/dbbkp/scan
# DK_ACTION_REQUESTS_DIR=/opt/dbbkp/actions/requests
# DK_ACTION_RESULTS_DIR=/opt/dbbkp/actions/results
# GITHUB_WEBHOOK_SECRET=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
