# Deploy King settings for deploy/compose.yml. Copy to deploy/.env, or run: bash deploy/gen-env.sh
# Keep comments on their own lines. Use letters and digits only in passwords (they go into URLs).

# ── Secrets (required) ─────────────────────────────────────────────
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 24
REDIS_PASSWORD=
# openssl rand -hex 48
JWT_SECRET=
# openssl rand -hex 32
INTERNAL_SECRET=
# 64 hex characters: openssl rand -hex 32. Encrypts stored variables and tokens. Keep a copy.
MASTER_KEY=
# Checks that push events really come from GitHub (made by the installer)
GITHUB_WEBHOOK_SECRET=

# ── First admin ────────────────────────────────────────────────────
# Created when there is no user yet. Asked to change the password at the first sign-in.
# Empty: a password is made up and printed once in the API's log (docker logs dbbkp-api).
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=

# ── Addresses ──────────────────────────────────────────────────────
# Apps get <name>.<DBBKP_BASE_DOMAIN>. "localhost" works in a browser on the same machine.
DBBKP_BASE_DOMAIN=localhost
# The panel through the proxy (the panel also answers on PANEL_PORT directly).
PANEL_DOMAIN=portal.localhost
# true only together with compose.tls.yml (see COMPOSE_FILE below)
DBBKP_TLS=false
# Let's Encrypt account e-mail (HTTPS only)
ACME_EMAIL=
# Shown as the address for webhooks, e.g. https://portal.example.com
PUBLIC_API_URL=
# The panel's public address, used in links in e-mails (invitations, alerts). Empty: PUBLIC_API_URL.
# PANEL_URL=
# PUBLIC_PANEL_URL=
# DK_PANEL_ADDRESS=
# WebSockets on another address than the panel's own (rare; read when the panel image is built)
# NEXT_PUBLIC_WS_URL=

# ── Ports on this machine ──────────────────────────────────────────
PANEL_BIND=0.0.0.0
PANEL_PORT=3000
# The API is published for local tools only
API_BIND=127.0.0.1
API_PORT=4000
TRAEFIK_HTTP_PORT=80
TRAEFIK_HTTPS_PORT=443

# ── Images ─────────────────────────────────────────────────────────
# Built from this checkout by default. For the published images:
#   DK_IMAGE_PREFIX=ghcr.io/iamprashanta/deploy-king and DK_TAG=latest (or a version), then
#   docker compose pull && docker compose up -d --no-build
DK_IMAGE_PREFIX=deploy-king
DK_TAG=local
# Source checkout to build from (relative to this folder)
DK_SOURCE=..

# ── Optional ───────────────────────────────────────────────────────
# HTTPS: COMPOSE_FILE=compose.yml:compose.tls.yml
# Where app sources are kept: a named volume, or a folder such as /var/www/sites
# DK_SITES_DIR=dk-sites
# Server watch (scripts/install-scan.sh): folders on the host
# DK_SCAN_DIR=/opt/dbbkp/scan
# DK_ACTION_REQUESTS_DIR=/opt/dbbkp/actions/requests
# DK_ACTION_RESULTS_DIR=/opt/dbbkp/actions/results
# Backups. The folder inside the containers is /var/backups/dbbkp, kept in the dk-backups volume
# (or a folder on this machine: DK_BACKUP_VOLUME=/var/backups/dbbkp).
# DK_BACKUP_VOLUME=dk-backups
# Docker's folder for named volumes, read by backups (change it only for a non-default Docker data root)
# DK_DOCKER_VOLUMES_DIR=/var/lib/docker/volumes
# DK_PG_ADMIN_URL=
# DK_PG_BIN=
# RCLONE_BIN=
# Recordings of terminal sessions to servers
# DK_SSH_RECORDINGS_VOLUME=dk-ssh-recordings

# ── Desktop mode (Deploy King Desktop's own machine) ───────────────
# Not set in this file: the app writes these to /etc/deploy-king/desktop.env inside its machine,
# and compose.desktop.yml gives that file to the API. After a change: docker compose up -d again.
# The app signs in with its own key (read on every call); registering is closed.
# DESKTOP_MODE=true
# DESKTOP_KEY_FILE=/etc/deploy-king/desktop.key
# With a Deploy King account: every deploy and change needs a ticket, the account's signed
# one-time approval, in the x-dk-ticket header. Only together with DESKTOP_MODE=true.
# DESKTOP_REQUIRE_TICKETS=true
# The control server's public keys, a JSON list of { "kid", "alg": "Ed25519", "publicKey" },
# and this computer's device id as plain text. The app writes both; the API reads them on every call.
# DESKTOP_TICKET_KEYS_FILE=/etc/deploy-king/ticket-keys.json
# DESKTOP_DEVICE_FILE=/etc/deploy-king/device-id

# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=
